APP_NAME=Matchday
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Host ports - defaults: app 8000, MySQL 3306. If a default is taken, bump it
# (8001, 8002... / 3307, 3308...) and update APP_URL to match
APP_PORT=8000
FORWARD_DB_PORT=3306

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
# Container-internal host and port (default 3306); use FORWARD_DB_PORT from the host
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=matchday
DB_USERNAME=matchday
DB_PASSWORD=secret
DB_ROOT_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# PostHog (Cloud EU). Leave the token empty to run with the null analytics driver
POSTHOG_DISABLED=false
POSTHOG_PROJECT_TOKEN=
# Personal API key (phx_...) or project secret key (phs_...) for local flag evaluation; server-side only
POSTHOG_PERSONAL_API_KEY=
POSTHOG_HOST=https://eu.i.posthog.com
POSTHOG_ASSETS_HOST=https://eu-assets.i.posthog.com
POSTHOG_UI_HOST=https://eu.posthog.com
POSTHOG_PROXY_PATH=ingest
POSTHOG_QUEUE=analytics
# Log channel for events when not sending to PostHog (e.g. single); empty drops them
POSTHOG_LOG_CHANNEL=
POSTHOG_DEBUG=false
# Flag evaluation: local (needs POSTHOG_PERSONAL_API_KEY) or remote
POSTHOG_FLAG_EVALUATION=local
POSTHOG_FLAG_DEFINITIONS_TTL=60
POSTHOG_FLAG_EXPOSURE_TTL=86400

# Laravel Pennant store: posthog (PostHog flags, app fallbacks without a token), database or array
PENNANT_STORE=posthog
